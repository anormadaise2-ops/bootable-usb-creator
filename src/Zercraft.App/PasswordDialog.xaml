<Window x:Class="Zercraft.App.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Code d’accès" Height="230" Width="430"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="White">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Saisissez le code de sauvegarde" FontSize="18" FontWeight="Bold" />
        <StackPanel Grid.Row="1" Margin="0,12,0,14">
            <TextBlock Text="Le code est utilisé localement pour vérifier puis déchiffrer le fichier." />
            <PasswordBox x:Name="PasswordInput" Margin="0,10,0,0" Height="32" Padding="8,5" />
            <TextBlock x:Name="ErrorText" Margin="0,6,0,0" Foreground="#B91C1C" />
        </StackPanel>
        <DockPanel Grid.Row="2" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Annuler" IsCancel="True" />
            <Button DockPanel.Dock="Right" Content="Continuer" Margin="0,0,8,0"
                    Background="#1677FF" Foreground="White" Click="ContinueButton_Click" />
        </DockPanel>
    </Grid>
</Window>
