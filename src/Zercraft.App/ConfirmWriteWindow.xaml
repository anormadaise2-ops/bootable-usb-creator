<Window x:Class="Zercraft.App.ConfirmWriteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmer l’effacement" Height="350" Width="560"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#FFFFFF">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Confirmez l’effacement du périphérique"
                   FontSize="20" FontWeight="Bold" Foreground="#991B1B" TextWrapping="Wrap" />
        <StackPanel Grid.Row="1" Margin="0,16,0,14">
            <TextBlock x:Name="TargetText" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="ImageText" Margin="0,8,0,12" TextWrapping="Wrap" />
            <TextBlock Text="Toutes les données de ce disque seront perdues. Pour confirmer, saisissez exactement :"
                       Foreground="#7F1D1D" TextWrapping="Wrap" />
            <TextBlock x:Name="PhraseText" Margin="0,7,0,6" FontWeight="Bold" FontFamily="Consolas" />
            <TextBox x:Name="ConfirmationInput" Height="30" TextChanged="ConfirmationInput_TextChanged" />
        </StackPanel>
        <DockPanel Grid.Row="2" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Annuler" IsCancel="True" />
            <Button x:Name="ConfirmButton" DockPanel.Dock="Right" Margin="0,0,8,0"
                    Content="Confirmer l’effacement" IsEnabled="False"
                    Background="#B91C1C" Foreground="White" Click="ConfirmButton_Click" />
        </DockPanel>
    </Grid>
</Window>
