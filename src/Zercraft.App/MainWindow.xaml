<Window x:Class="Zercraft.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zercraft" Height="800" Width="920" MinHeight="700" MinWidth="780"
        WindowStartupLocation="CenterScreen" Background="#EDF3FB">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Ellipse Grid.RowSpan="4" Width="430" Height="430" HorizontalAlignment="Right"
                 VerticalAlignment="Top" Margin="0,-210,-210,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#7055A7FF" Offset="0" />
                    <GradientStop Color="#004F82FF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Grid.RowSpan="4" Width="350" Height="350" HorizontalAlignment="Left"
                 VerticalAlignment="Bottom" Margin="-210,0,0,-170" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#605E8CFF" Offset="0" />
                    <GradientStop Color="#003C68F5" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <Border Width="46" Height="46" CornerRadius="13" DockPanel.Dock="Left">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4B9AFF" Offset="0" />
                        <GradientStop Color="#1558CA" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="Z" Foreground="White" FontSize="27" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Zercraft" FontSize="25" FontWeight="Bold" Foreground="#172B4D" />
                <TextBlock Text="Clés bootables et sauvegardes privées" Foreground="#64748B" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Padding="8" CornerRadius="20"
                Background="{StaticResource GlassSurfaceBrush}"
                BorderBrush="#DFFFFFFF" BorderThickness="1">
        <TabControl x:Name="MainTabs" Background="Transparent" BorderThickness="0">
            <TabItem Header="Clé bootable">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Créer un support de démarrage" FontSize="20" FontWeight="Bold"
                                   Foreground="#172B4D" />
                        <TextBlock Margin="0,5,0,16" Foreground="#64748B" TextWrapping="Wrap"
                                   Text="Choisissez une image ISO et une clé USB précise. L’écriture brute efface entièrement le disque sélectionné." />
                        <GroupBox Header="Image ISO">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="IsoPathText" Text="Aucune image sélectionnée"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="IsoSizeText" Margin="0,5,0,0"
                                               Foreground="#64748B" FontSize="12" />
                                </StackPanel>
                                <Button x:Name="ChooseIsoButton" Grid.Column="1" Content="Choisir une ISO…"
                                        Click="ChooseIsoButton_Click" />
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="Périphérique USB">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,9">
                                    <TextBlock VerticalAlignment="Center" Foreground="#64748B"
                                               Text="Seuls les disques USB sont affichés." />
                                    <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Actualiser"
                                            Click="RefreshButton_Click" />
                                </DockPanel>
                                <ComboBox x:Name="DiskList" Height="34" DisplayMemberPath="DisplayName"
                                          SelectionChanged="DiskList_SelectionChanged" />
                                <TextBlock x:Name="DiskDetailsText" Margin="0,8,0,0" Foreground="#64748B"
                                           FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </GroupBox>
                        <Border Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1"
                                CornerRadius="6" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Attention : le disque choisi sera entièrement effacé."
                                           FontWeight="Bold" Foreground="#9A3412" />
                                <TextBlock Margin="0,5,0,0" Foreground="#7C2D12" TextWrapping="Wrap"
                                           Text="Les ISO hybrides compatibles démarrent sur USB ; les ISO Windows habituelles ne sont pas garanties par l’écriture brute. Une interruption peut rendre la clé inutilisable. Aucune écriture ne démarre sans confirmation et saisie du numéro du disque." />
                            </StackPanel>
                        </Border>
                        <ProgressBar x:Name="WriteProgress" Height="12" Minimum="0" Maximum="100" />
                        <Button x:Name="WriteButton" Margin="0,14,0,0" HorizontalAlignment="Right"
                                Content="Créer la clé bootable" IsEnabled="False"
                                Background="#1677FF" Foreground="White" Click="WriteButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Sauvegarder">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Sauvegarde chiffrée sur USB" FontSize="20" FontWeight="Bold"
                                   Foreground="#172B4D" />
                        <TextBlock Margin="0,5,0,16" Foreground="#64748B" TextWrapping="Wrap"
                                   Text="Choisissez des fichiers, un code d’accès et le lieu de sauvegarde (par exemple une clé USB). Zercraft chiffre les fichiers sans déplacer ni supprimer les originaux." />
                        <GroupBox Header="Enregistrer une sauvegarde">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock x:Name="BackupFilesText" VerticalAlignment="Center"
                                               Text="Aucun fichier sélectionné" TextWrapping="Wrap" />
                                    <Button DockPanel.Dock="Right" Content="Choisir des fichiers…"
                                            Click="ChooseBackupFilesButton_Click" />
                                </DockPanel>
                                <TextBlock Margin="0,12,0,4" Text="Code d’accès (8 caractères minimum)" />
                                <PasswordBox x:Name="BackupPassword" Height="32" Padding="8,5" />
                                <TextBlock Margin="0,8,0,4" Text="Confirmer le code d’accès" />
                                <PasswordBox x:Name="ConfirmBackupPassword" Height="32" Padding="8,5" />
                                <Button x:Name="CreateBackupButton" Margin="0,14,0,0"
                                        HorizontalAlignment="Right" Content="Chiffrer et enregistrer"
                                        Background="#1677FF" Foreground="White"
                                        Click="CreateBackupButton_Click" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Restaurer une sauvegarde">
                            <StackPanel>
                                <TextBlock Foreground="#64748B" TextWrapping="Wrap"
                                           Text="Choisissez une sauvegarde Zercraft et un code d’accès. Les fichiers seront extraits dans un nouveau dossier, sans écraser d’autres fichiers." />
                                <Button x:Name="RestoreBackupButton" Margin="0,12,0,0"
                                        HorizontalAlignment="Right" Content="Choisir la sauvegarde et restaurer…"
                                        Click="RestoreBackupButton_Click" />
                            </StackPanel>
                        </GroupBox>
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                CornerRadius="6" Padding="14">
                            <TextBlock Foreground="#1E3A8A" TextWrapping="Wrap"
                                       Text="Le code n’est jamais enregistré. Si vous le perdez, la sauvegarde ne pourra pas être déchiffrée. Gardez une copie du fichier .zercraftbackup et du code dans un endroit sûr." />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Télécharger une ISO">
                <StackPanel Margin="20">
                    <TextBlock Text="Images officielles" FontSize="20" FontWeight="Bold"
                               Foreground="#172B4D" />
                    <TextBlock Margin="0,5,0,16" Foreground="#64748B" TextWrapping="Wrap"
                               Text="Sources officielles uniquement. Ubuntu et Debian sont téléchargés directement et vérifiés avec le SHA-256 publié par leur éditeur. Pour Windows, Microsoft génère le lien sur son site officiel." />
                    <ComboBox x:Name="IsoSourceList" Height="38" DisplayMemberPath="Name"
                              SelectionChanged="IsoSourceList_SelectionChanged" />
                    <TextBlock x:Name="IsoSourceDescription" Margin="0,10,0,12"
                               Foreground="#334155" TextWrapping="Wrap" />
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock x:Name="IsoAttributionText" VerticalAlignment="Center"
                                   Foreground="#64748B" />
                        <Button x:Name="DownloadIsoButton" DockPanel.Dock="Right"
                                Content="Télécharger et vérifier" Background="#1677FF"
                                Foreground="White" Click="DownloadIsoButton_Click" />
                    </DockPanel>
                    <ProgressBar x:Name="DownloadProgress" Height="12" Minimum="0" Maximum="100" />
                    <TextBlock x:Name="DownloadDetailsText" Margin="0,9,0,0"
                               Foreground="#64748B" TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>
        </TabControl>
        </Border>

        <Border Grid.Row="2" Margin="0,12,0,8" Padding="11,8" CornerRadius="10"
                Background="#DFFFFFFF" BorderBrush="#BFFFFFFF" BorderThickness="1">
            <TextBlock x:Name="StatusText" Foreground="#334155" TextWrapping="Wrap"
                       Text="Initialisation…" />
        </Border>
        <DockPanel Grid.Row="3" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#94A3B8"
                       Text="Zercraft · les sources ISO restent la propriété de leurs éditeurs." />
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Annuler"
                    IsEnabled="False" Visibility="Collapsed" Click="CancelButton_Click" />
        </DockPanel>
    </Grid>
</Window>
